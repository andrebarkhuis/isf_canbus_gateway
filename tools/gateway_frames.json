      "signals": [
        {"module": "isf", "uniqueId": "isf.0B4.VehicleSpeed", "name": "VehicleSpeed", "startBit": 0, "bits": 16, "factor": 0.0565, "offset": 0, "unit": "km/h", "adu": "ecu.speed"}
      ]
    },
