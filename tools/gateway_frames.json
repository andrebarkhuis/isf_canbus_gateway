        {"module": "engine", "uniqueId": "vxpyKZ0Zo", "name": "EngineRPM", "startBit": 32, "bits": 14, "factor": 1, "offset": 0, "unit": "rpm"}
      ]
    },
    {
      "id": "0x142", "name": "GT86_EngineMisc", "gt86": true, "interval": 10,
